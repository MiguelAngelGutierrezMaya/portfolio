---
import type { Experience } from '@portfolio/domain/models/Portfolio';

interface Props {
  experience: Experience;
  index: number;
}

const { experience, index } = Astro.props;
---

<article class="experience-item reveal">
  <div class="experience-item__number">{String(index + 1).padStart(2, '0')}</div>
  <div class="experience-item__role">
    {
      experience.logo ? (
        <img
          class="experience-item__logo"
          src={experience.logo.src}
          alt={experience.logo.alt}
          width={experience.logo.width}
          height={experience.logo.height}
          loading="lazy"
          decoding="async"
        />
      ) : null
    }
    <div class="experience-item__role-copy">
      <h3>{experience.role}</h3>
      {
        experience.website ? (
          <a href={experience.website} target="_blank" rel="noreferrer">
            {experience.company} <span aria-hidden="true">↗</span>
          </a>
        ) : (
          <span>{experience.company}</span>
        )
      }
    </div>
  </div>
  <p>{experience.summary}</p>
  <time datetime={`${experience.startDate}/${experience.endDate}`}>{experience.period}</time>
</article>
