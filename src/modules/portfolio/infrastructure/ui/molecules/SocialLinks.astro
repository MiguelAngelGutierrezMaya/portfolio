---
import type { SocialLink } from '@portfolio/domain/models/Portfolio';

interface Props {
  label: string;
  links: readonly SocialLink[];
}

const { label, links } = Astro.props;
---

<nav class="social-links" aria-label={label}>
  {links.map(link => (
    <a href={link.href} rel="me">
      {link.emoji && (
        <span class="social-links__emoji" aria-hidden="true">
          {link.emoji}
        </span>
      )}
      <span class="social-links__copy">
        <strong>{link.label}</strong>
        {link.description && <small>{link.description}</small>}
      </span>
    </a>
  ))}
</nav>
