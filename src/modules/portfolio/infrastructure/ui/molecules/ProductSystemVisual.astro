---
import type { PortfolioUiCopy } from '@i18n/infrastructure/uiCopy';

interface Props {
  copy: PortfolioUiCopy['productSystem'];
}

const { copy } = Astro.props;
---

<figure class="product-system glass-panel" aria-labelledby="product-system-caption">
  <div class="product-system__topbar" aria-hidden="true">
    <span></span><span></span><span></span>
    <strong>migudev / production</strong>
    <small>{copy.status}</small>
  </div>

  <div class="product-system__map">
    <div class="product-system__glow" aria-hidden="true"></div>
    <svg viewBox="0 0 620 500" aria-hidden="true" focusable="false">
      <path class="product-system__path" d="M310 250 L310 82"></path>
      <path class="product-system__path product-system__path--delay" d="M310 250 L512 206"></path>
      <path class="product-system__path" d="M310 250 L430 414"></path>
      <path class="product-system__path product-system__path--delay" d="M310 250 L104 324"></path>
      <circle class="product-system__orbit" cx="310" cy="250" r="174"></circle>
    </svg>

    <div class="product-system__node product-system__node--core">
      <span>01</span>
      <strong>{copy.core}</strong>
      <small>{copy.coreValue}</small>
    </div>
    <div class="product-system__node product-system__node--web">
      <span>02</span><strong>Web</strong><small>{copy.interfaces}</small>
    </div>
    <div class="product-system__node product-system__node--api">
      <span>03</span><strong>APIs</strong><small>{copy.services}</small>
    </div>
    <div class="product-system__node product-system__node--cloud">
      <span>04</span><strong>Cloud</strong><small>{copy.delivery}</small>
    </div>
    <div class="product-system__node product-system__node--mobile">
      <span>05</span><strong>Mobile</strong><small>{copy.nativeFlows}</small>
    </div>
  </div>

  <figcaption id="product-system-caption" class="product-system__caption">
    <span>{copy.eyebrow}</span>
    <strong>{copy.caption}</strong>
  </figcaption>
</figure>
