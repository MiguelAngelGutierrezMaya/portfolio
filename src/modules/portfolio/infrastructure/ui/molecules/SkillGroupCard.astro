---
import type { SkillGroup } from '@portfolio/domain/models/Portfolio';

interface Props {
  group: SkillGroup;
  technologiesLabel?: string;
}

const { group, technologiesLabel = 'technologies' } = Astro.props;
---

<article class="skill-group reveal">
  <div>
    <h3>{group.title}</h3>
    <p>{group.description}</p>
  </div>
  <ul aria-label={`${group.title} ${technologiesLabel}`}>
    {group.skills.map(skill => <li>{skill}</li>)}
  </ul>
</article>
