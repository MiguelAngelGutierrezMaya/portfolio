---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="section-heading reveal">
  <span class="eyebrow"><span aria-hidden="true"></span>{eyebrow}</span>
  <div class="section-heading__content">
    <h2>{title}</h2>
    {description && <p>{description}</p>}
  </div>
</header>
