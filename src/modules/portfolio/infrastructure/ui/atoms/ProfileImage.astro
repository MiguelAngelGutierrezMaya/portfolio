---
interface Props {
  alt: string;
  className?: string;
  sizes: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const { alt, className, sizes, loading = 'lazy', fetchpriority = 'auto' } = Astro.props;
---

<picture>
  <source
    type="image/avif"
    srcset="/media/profile/miguel-gutierrez-portrait-320.avif 320w, /media/profile/miguel-gutierrez-portrait-480.avif 480w, /media/profile/miguel-gutierrez-portrait-640.avif 640w"
    {sizes}
  />
  <source
    type="image/webp"
    srcset="/media/profile/miguel-gutierrez-portrait-320.webp 320w, /media/profile/miguel-gutierrez-portrait-480.webp 480w, /media/profile/miguel-gutierrez-portrait-640.webp 640w"
    {sizes}
  />
  <img
    class={className}
    src="/media/profile/miguel-gutierrez-portrait-640.webp"
    srcset="/media/profile/miguel-gutierrez-portrait-320.webp 320w, /media/profile/miguel-gutierrez-portrait-480.webp 480w, /media/profile/miguel-gutierrez-portrait-640.webp 640w"
    {sizes}
    {alt}
    width="640"
    height="800"
    {loading}
    {fetchpriority}
    decoding="async"
  />
</picture>
