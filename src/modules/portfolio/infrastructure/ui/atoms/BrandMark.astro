---
import type { Profile } from '@portfolio/domain/models/Portfolio';

interface Props {
  profile: Profile;
  compact?: boolean;
}

const { profile, compact = false } = Astro.props;
---

<a class="brand" href="/" aria-label={compact ? `${profile.brandName} home` : undefined}>
  <span class="brand__mark" aria-hidden="true">
    <img
      class="brand__logo"
      src="/media/brand/migudev-logo-92.webp"
      srcset="/media/brand/migudev-logo-92.webp 1x, /media/brand/migudev-logo-184.webp 2x"
      alt=""
      width="92"
      height="92"
      loading="eager"
      decoding="async"
    />
  </span>
  {
    !compact && (
      <span class="brand__copy">
        <strong>{profile.name}</strong>
        <small>{profile.jobTitle}</small>
      </span>
    )
  }
</a>
