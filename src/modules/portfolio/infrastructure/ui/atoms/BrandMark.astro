---
import { Image } from 'astro:assets';

import logo from '@/assets/migudev-logo.webp';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<a class="brand" href="/" aria-label={compact ? 'Migudev home' : undefined}>
  <span class="brand__mark" aria-hidden="true">
    <Image class="brand__logo" src={logo} alt="" width={92} height={92} quality={88} />
  </span>
  {
    !compact && (
      <span class="brand__copy">
        <strong>Miguel Gutierrez</strong>
        <small>Fullstack product engineer</small>
      </span>
    )
  }
</a>
