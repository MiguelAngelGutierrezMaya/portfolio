---
import ContactForm from '@contact/infrastructure/ui/organisms/ContactForm';
import SectionHeading from '@portfolio/infrastructure/ui/atoms/SectionHeading.astro';
---

<section id="contact" class="content-section section-shell" aria-labelledby="contact-title">
  <div class="contact-panel reveal">
    <div class="contact-panel__intro">
      <SectionHeading
        headingId="contact-title"
        eyebrow="Let’s build"
        title="Have a meaningful product challenge?"
        description="Tell me about the product, the team and the outcome you are pursuing. I am open to full-time roles and focused collaborations."
      />
      <div class="contact-panel__direct">
        <span>Prefer email?</span>
        <a href="mailto:gutierrezmayamiguelangel@gmail.com">gutierrezmayamiguelangel@gmail.com</a>
      </div>
    </div>
    <div class="contact-panel__form glass-panel">
      <ContactForm client:visible />
    </div>
  </div>
</section>
