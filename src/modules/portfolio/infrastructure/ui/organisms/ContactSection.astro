---
import ContactForm from '@contact/infrastructure/ui/organisms/ContactForm';
import SectionHeading from '@portfolio/infrastructure/ui/atoms/SectionHeading.astro';
import type { ContactContent, Profile, SectionCopy } from '@portfolio/domain/models/Portfolio';

interface Props {
  heading: SectionCopy;
  contact: ContactContent;
  profile: Profile;
}

const { heading, contact, profile } = Astro.props;
---

<section id="contact" class="content-section section-shell" aria-labelledby="contact-title">
  <div class="contact-panel reveal">
    <div class="contact-panel__intro">
      <SectionHeading
        headingId="contact-title"
        eyebrow={heading.eyebrow}
        title={heading.title}
        description={heading.description}
      />
      <div class="contact-panel__direct">
        <span>{contact.emailPrompt}</span>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </div>
    </div>
    <div class="contact-panel__form glass-panel">
      <ContactForm client:visible />
    </div>
  </div>
</section>
