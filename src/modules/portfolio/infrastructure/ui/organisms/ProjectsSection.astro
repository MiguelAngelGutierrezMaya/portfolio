---
import type { Project, SectionCopy } from '@portfolio/domain/models/Portfolio';
import type { ProjectExplorerCopy } from '@i18n/infrastructure/uiCopy';
import SectionHeading from '@portfolio/infrastructure/ui/atoms/SectionHeading.astro';
import ProjectExplorer from '@portfolio/infrastructure/ui/organisms/ProjectExplorer/ProjectExplorer';

interface Props {
  projects: readonly Project[];
  heading: SectionCopy;
  copy: ProjectExplorerCopy;
}

const { projects, heading, copy } = Astro.props;
---

<section id="work" class="content-section section-shell" aria-labelledby="work-title">
  <SectionHeading
    headingId="work-title"
    eyebrow={heading.eyebrow}
    title={heading.title}
    description={heading.description}
  />
  <div>
    <ProjectExplorer projects={projects} copy={copy} client:visible />
  </div>
</section>
