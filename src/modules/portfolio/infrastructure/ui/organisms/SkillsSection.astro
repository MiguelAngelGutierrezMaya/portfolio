---
import type { SectionCopy, SkillGroup } from '@portfolio/domain/models/Portfolio';
import SectionHeading from '@portfolio/infrastructure/ui/atoms/SectionHeading.astro';
import SkillGroupCard from '@portfolio/infrastructure/ui/molecules/SkillGroupCard.astro';

interface Props {
  skillGroups: readonly SkillGroup[];
  heading: SectionCopy;
}

const { skillGroups, heading } = Astro.props;
const marqueeSkills = skillGroups.flatMap(group => group.skills);
---

<section class="content-section skills-section" aria-labelledby="skills-title">
  <div class="section-shell">
    <SectionHeading
      headingId="skills-title"
      eyebrow={heading.eyebrow}
      title={heading.title}
      description={heading.description}
    />
  </div>
  <div class="skills-marquee" aria-hidden="true">
    <div class="skills-marquee__track">
      {
        [...marqueeSkills, ...marqueeSkills].map(skill => (
          <span>
            {skill}
            <i />
          </span>
        ))
      }
    </div>
  </div>
  <div class="skill-grid section-shell">
    {skillGroups.map(group => <SkillGroupCard group={group} />)}
  </div>
</section>
