---
import CapabilityCard from '@portfolio/infrastructure/ui/molecules/CapabilityCard.astro';
import SectionHeading from '@portfolio/infrastructure/ui/atoms/SectionHeading.astro';
import type { Capability, SectionCopy } from '@portfolio/domain/models/Portfolio';

interface Props {
  heading: SectionCopy;
  capabilities: readonly Capability[];
}

const { heading, capabilities } = Astro.props;
---

<section class="content-section section-shell" aria-labelledby="capabilities-title">
  <SectionHeading
    headingId="capabilities-title"
    eyebrow={heading.eyebrow}
    title={heading.title}
    description={heading.description}
  />
  <div class="capability-grid">
    {
      capabilities.map((capability, index) => (
        <CapabilityCard
          index={String(index + 1).padStart(2, '0')}
          title={capability.title}
          description={capability.description}
          keywords={capability.keywords}
        />
      ))
    }
  </div>
</section>
