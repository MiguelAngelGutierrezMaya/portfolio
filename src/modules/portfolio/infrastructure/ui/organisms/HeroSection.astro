---
import ButtonLink from '@portfolio/infrastructure/ui/atoms/ButtonLink.astro';
import Metric from '@portfolio/infrastructure/ui/molecules/Metric.astro';
import ProfilePortrait from '@portfolio/infrastructure/ui/molecules/ProfilePortrait.astro';
import SocialLinks from '@portfolio/infrastructure/ui/molecules/SocialLinks.astro';
import type { Profile } from '@portfolio/domain/models/Portfolio';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
---

<section id="about" class="hero section-shell" aria-labelledby="hero-title">
  <div class="hero__ambient" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="hero__copy">
    <span class="eyebrow hero__eyebrow"><span aria-hidden="true"></span>{profile.location}</span>
    <h1 id="hero-title">
      {profile.headline.lead}
      <span class="hero__accent">{profile.headline.accent}</span>
    </h1>
    <p>{profile.introduction}</p>
    <div class="hero__actions">
      <ButtonLink href={profile.primaryAction.href} label={profile.primaryAction.label} />
      <ButtonLink
        href={profile.secondaryAction.href}
        label={profile.secondaryAction.label}
        variant="secondary"
      />
    </div>
  </div>

  <div class="hero__side">
    <ProfilePortrait portraitContent={profile.portrait} />
    <SocialLinks label="Hero social profiles" links={profile.socialLinks} />
  </div>

  <div class="hero__metrics glass-panel reveal">
    {profile.metrics.map(metric => <Metric value={metric.value} label={metric.label} />)}
  </div>
</section>
