---
import { resolvePreferredLocale } from '@i18n/application/resolvePreferredLocale';
import { localizedRoutes } from '@i18n/domain/Locale';

export const prerender = false;

const locale = resolvePreferredLocale(
  Astro.preferredLocale,
  Astro.request.headers.get('accept-language')
);

Astro.response.status = 302;
Astro.response.headers.set('Location', localizedRoutes[locale].home);
Astro.response.headers.set('Cache-Control', 'no-store, max-age=0');
Astro.response.headers.set('Vary', 'Accept-Language');
---
