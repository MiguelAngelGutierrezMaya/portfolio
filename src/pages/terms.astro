---
import Layout from '@layouts/Layout.astro';
import { GetLegalDocument } from '@legal/application/use-cases/GetLegalDocument';
import { StaticLegalRepository } from '@legal/infrastructure/repositories/StaticLegalRepository';
import LegalPage from '@legal/infrastructure/ui/templates/LegalPage.astro';

export const prerender = true;

const document = GetLegalDocument.execute(new StaticLegalRepository(), 'terms', 'en');
---

<Layout
  title={`${document.title} — Miguel Gutierrez`}
  description={document.description}
  pathname="/terms/"
  locale="en"
  page="terms"
>
  <LegalPage {document} locale="en" page="terms" />
</Layout>
