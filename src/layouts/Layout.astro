---
import '@styles/tokens.css';
import '@styles/base.css';
import '@styles/components.css';
import '@styles/animations.css';

interface Props {
  title: string;
  description: string;
  pathname?: string;
  structuredData?: Record<string, unknown>;
}

const { title, description, pathname = Astro.url.pathname, structuredData } = Astro.props;
const configuredSite = import.meta.env.PUBLIC_SITE_URL;
const siteUrl = configuredSite?.startsWith('http') ? configuredSite : Astro.url.origin;
const canonicalUrl = new URL(pathname, siteUrl).toString();
const socialImage = new URL('/og.png', siteUrl).toString();
const facebookVerification = import.meta.env.PUBLIC_FACEBOOK_DOMAIN_VERIFICATION;
const websiteStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', siteUrl).toString(),
  url: siteUrl,
  name: 'Migudev',
  alternateName: 'Miguel Gutierrez Portfolio',
  inLanguage: 'en',
};
const pageStructuredData = structuredData ?? websiteStructuredData;
const serializedStructuredData = JSON.stringify(pageStructuredData).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Miguel Angel Gutierrez Maya" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#090b0f" />
    <meta name="color-scheme" content="dark" />
    {
      facebookVerification && (
        <meta name="facebook-domain-verification" content={facebookVerification} />
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="alternate" type="text/plain" title="LLM-readable site overview" href="/llms.txt" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Migudev" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta
      property="og:image:alt"
      content="Migudev — Miguel Gutierrez, Product Engineer, Fullstack & Mobile"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta
      name="twitter:image:alt"
      content="Migudev — Miguel Gutierrez, Product Engineer, Fullstack & Mobile"
    />
    <script is:inline type="application/ld+json" set:html={serializedStructuredData} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import { registerWebVitals } from '@/modules/observability/infrastructure/browser/registerWebVitals';

      registerWebVitals();

      const header = document.querySelector<HTMLElement>('[data-site-header]');
      const revealElements = document.querySelectorAll<HTMLElement>('.reveal');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const updateHeader = () => {
        if (header) header.dataset.scrolled = String(window.scrollY > 24);
      };

      updateHeader();
      window.addEventListener('scroll', updateHeader, { passive: true });

      if (reduceMotion || !('IntersectionObserver' in window)) {
        revealElements.forEach(element => element.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          entries => {
            entries.forEach(entry => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        revealElements.forEach(element => observer.observe(element));
      }

      document.querySelectorAll<HTMLAnchorElement>('.mobile-nav a').forEach(link => {
        link.addEventListener('click', () => link.closest('details')?.removeAttribute('open'));
      });

      if (window.matchMedia('(pointer: fine)').matches) {
        window.addEventListener(
          'pointermove',
          event => {
            document.body.style.setProperty('--pointer-x', `${event.clientX}px`);
            document.body.style.setProperty('--pointer-y', `${event.clientY}px`);
          },
          { passive: true }
        );
      }
    </script>
  </body>
</html>
