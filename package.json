{
  "name": "miguel-gutierrez-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "sync:content": "node tools/sync-managed-content.mjs",
    "build": "pnpm typecheck && pnpm check:astro && astro build",
    "typecheck": "tsc --noEmit",
    "check:astro": "pnpm --dir tools/quality-compat check:astro",
    "preview": "astro preview",
    "lint": "pnpm --dir tools/quality-compat lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:performance": "lhci autorun",
    "audit": "pnpm audit",
    "audit:prod": "pnpm audit --prod",
    "check:peers": "pnpm peers check",
    "check": "pnpm format:check && pnpm lint && pnpm test:coverage && pnpm build && pnpm check:peers && pnpm audit",
    "check:all": "pnpm check && pnpm test:e2e && pnpm test:performance"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "astro": "^7.1.6",
    "framer-motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "web-vitals": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
