{
  "name": "miguel-gutierrez-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "pnpm prepare:media && astro dev",
    "start": "pnpm prepare:media && astro dev",
    "sync:content": "node tools/sync-managed-content.mjs",
    "prepare:media": "node tools/optimize-managed-media.mjs",
    "build:lambda:content": "esbuild infra/functions/content-presigner/handler.ts --bundle --platform=node --target=node24 --format=cjs --sourcemap --outfile=.artifacts/content-presigner/index.cjs",
    "build:lambda:contact": "esbuild infra/functions/contact-mailer/handler.ts --bundle --platform=node --target=node24 --format=cjs --sourcemap --outfile=.artifacts/contact-mailer/index.cjs",
    "build:lambda": "pnpm build:lambda:content && pnpm build:lambda:contact",
    "build:infra:content": "SAM_CLI_TELEMETRY=0 sam build --template-file infra/content-store.yaml --build-dir .aws-sam/content",
    "build:infra:contact": "SAM_CLI_TELEMETRY=0 sam build --template-file infra/contact-mailer.yaml --build-dir .aws-sam/contact",
    "build:infra": "pnpm build:infra:content && pnpm build:infra:contact",
    "validate:infra": "SAM_CLI_TELEMETRY=0 sam validate --lint --template-file infra/content-store.yaml && SAM_CLI_TELEMETRY=0 sam validate --lint --template-file infra/contact-mailer.yaml",
    "build": "pnpm typecheck && pnpm check:astro && pnpm prepare:media && astro build",
    "typecheck": "tsc --noEmit",
    "check:astro": "pnpm --dir tools/quality-compat check:astro",
    "preview": "node .amplify-hosting/compute/default/entry.mjs",
    "lint": "pnpm --dir tools/quality-compat lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:performance": "lhci autorun",
    "audit": "pnpm audit",
    "audit:prod": "pnpm audit --prod",
    "check:peers": "pnpm peers check",
    "check": "pnpm format:check && pnpm lint && pnpm test:coverage && pnpm build:lambda && pnpm build && pnpm check:peers && pnpm audit",
    "check:all": "pnpm check && pnpm test:e2e && pnpm test:performance"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@aws-sdk/client-dynamodb": "^3.1114.0",
    "@aws-sdk/client-lambda": "^3.1114.0",
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/client-sesv2": "^3.1115.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "astro": "^7.1.6",
    "astro-aws-amplify": "^0.6.0",
    "framer-motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "web-vitals": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
